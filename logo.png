const Stripe = require('stripe');

module.exports = async function handler(req, res) {
  if (req.method !== 'GET') return res.status(405).json({ error: 'Method not allowed' });
  if (!process.env.STRIPE_SECRET_KEY) return res.status(500).json({ error: 'Stripe is not configured.' });
  try {
    const stripe = new Stripe(process.env.STRIPE_SECRET_KEY);
    const session = await stripe.checkout.sessions.retrieve(req.query.session_id);
    if (session.payment_status !== 'paid') return res.status(402).json({ error: 'Payment is not complete.' });
    return res.status(200).json({
      reservationId: session.client_reference_id,
      customerEmail: session.customer_details?.email,
      amount: session.amount_total,
      currency: session.currency,
      metadata: session.metadata
    });
  } catch (error) {
    return res.status(400).json({ error: 'Unable to retrieve reservation.' });
  }
};
